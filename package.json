{
  "name": "meu-mobile-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm tokens:sync && turbo run build",
    "build:packages": "pnpm tokens:sync && turbo run build --filter='./packages/*'",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "test": "turbo run test --concurrency=4",
    "test:e2e": "turbo run test:e2e --filter=@meu/next-h5-integration",
    "e2e:install": "pnpm --filter @meu/next-h5-integration exec playwright install chromium webkit",
    "typecheck": "turbo run typecheck",
    "check": "pnpm tokens:check && pnpm tokens:references && pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm compat:check && pnpm test:e2e",
    "compat:check": "node scripts/check-client-compat.mjs",
    "tokens:sync": "tsx packages/tokens/scripts/generate.ts",
    "tokens:check": "tsx packages/tokens/scripts/check.ts",
    "tokens:references": "node scripts/check-css-token-references.mjs",
    "changeset": "changeset",
    "storybook": "pnpm build:packages && pnpm --filter @meu/storybook dev",
    "docs": "pnpm build:packages && pnpm --filter @meu/docs dev",
    "playground": "pnpm build:packages && pnpm --filter @meu/playground dev",
    "integration": "pnpm build:packages && pnpm --filter @meu/next-h5-integration dev"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.4",
    "@microsoft/api-extractor": "7.59.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "20.19.43",
    "@vanilla-extract/rollup-plugin": "1.5.4",
    "chromatic": "18.6.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.6",
    "rollup": "4.63.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-preserve-directives": "1.1.3",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.11"
  }
}
