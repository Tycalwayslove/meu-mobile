    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@meu/date-adapter": "workspace:*",
    "@meu/mobile": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-hook-form": ">=7.55.0 <8.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.5.10",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "zod": "4.4.3"
  }
}
