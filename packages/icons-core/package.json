{
  "name": "@meu/icons-core",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "icons.lock.json",
    "licenses",
    "upstream"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./dist/icons.manifest.json"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly && cp src/icons.manifest.json dist/icons.manifest.json",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "icons:upstream:verify": "node scripts/verify-upstream.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm icons:check && vitest run --maxWorkers=1"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
