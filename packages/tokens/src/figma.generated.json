{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meu": {
    "color": {
      "light": {
        "canvas": { "$type": "color", "$value": "#F8F7F3" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "ink": { "$type": "color", "$value": "#1E2420" },
        "muted": { "$type": "color", "$value": "#5B625D" },
        "border": { "$type": "color", "$value": "#CDD1CC" },
        "subtle": { "$type": "color", "$value": "#EAECE7" },
        "accent": { "$type": "color", "$value": "#176B5B" },
        "accent-pressed": { "$type": "color", "$value": "#115244" },
        "accent-contrast": { "$type": "color", "$value": "#FFFFFF" },
        "success": { "$type": "color", "$value": "#287A52" },
        "warning": { "$type": "color", "$value": "#A45C13" },
        "danger": { "$type": "color", "$value": "#B63A36" }
      },
      "dark": {
        "canvas": { "$type": "color", "$value": "#161A17" },
        "surface": { "$type": "color", "$value": "#202620" },
        "ink": { "$type": "color", "$value": "#F0F2EC" },
        "muted": { "$type": "color", "$value": "#B7BDB5" },
        "border": { "$type": "color", "$value": "#3A423B" },
        "subtle": { "$type": "color", "$value": "#2B322C" },
        "accent": { "$type": "color", "$value": "#62B89D" },
        "accent-pressed": { "$type": "color", "$value": "#8DD0BB" },
        "accent-contrast": { "$type": "color", "$value": "#161A17" }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "10px" },
      "surface": { "$type": "dimension", "$value": "14px" },
      "sheet": { "$type": "dimension", "$value": "20px" },
      "round": { "$type": "dimension", "$value": "9999px" }
    },
    "size": {
      "control-compact": { "$type": "dimension", "$value": "32px" },
      "control-small": { "$type": "dimension", "$value": "36px" },
      "control-medium": { "$type": "dimension", "$value": "44px" },
      "control-large": { "$type": "dimension", "$value": "52px" },
      "navbar": { "$type": "dimension", "$value": "56px" },
      "tabbar": { "$type": "dimension", "$value": "56px" }
    },
    "font": {
      "ui": {
        "$type": "fontFamily",
        "$value": ["Geist", "Noto Sans SC", "PingFang SC", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["Geist Mono", "SFMono-Regular", "monospace"]
      },
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{meu.font.ui}",
          "fontSize": "24px",
          "fontWeight": 600,
          "lineHeight": "30px",
          "letterSpacing": "0em"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{meu.font.ui}",
          "fontSize": "20px",
          "fontWeight": 600,
          "lineHeight": "28px",
          "letterSpacing": "0em"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{meu.font.ui}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px",
          "letterSpacing": "0em"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{meu.font.ui}",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "20px",
          "letterSpacing": "0em"
        }
      },
      "meta": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{meu.font.ui}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "16px",
          "letterSpacing": "0em"
        }
      }
    },
    "motion": {
      "enter": { "$type": "duration", "$value": "180ms" },
      "exit": { "$type": "duration", "$value": "140ms" },
      "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    },
    "shadow": {
      "floating": {
        "$type": "shadow",
        "$value": {
          "color": "#18201A29",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0px"
        }
      }
    }
  }
}
