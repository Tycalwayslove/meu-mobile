  },
  "dependencies": {
    "@meu/mobile": "workspace:*",
    "@testing-library/react": "16.3.2",
    "axe-core": "4.13.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
